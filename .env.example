# Template defaults (Better Auth + Drizzle + local storage + Redis). `pnpm setup:project` regenerates this file.
# Core
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Public URL of this API (OpenAPI servers)
BACKEND_URL=http://localhost:3000
# Allowed browser origins, comma-separated
CORS_ORIGINS=http://localhost:5173
# true behind a reverse proxy/load balancer (Railway, Render, Fly), so client IPs are real
TRUST_PROXY=false
# Docker: pnpm db:up. Railway: ${{Postgres.DATABASE_URL}}. Supabase: Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# Max DB connections per instance
DATABASE_POOL_MAX=10
# Fail a request that waits longer than this for a free connection
DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Postgres cancels a statement that runs longer. 0 = no limit
DATABASE_STATEMENT_TIMEOUT_SECONDS=30
# Requests per client IP per window (in-memory, per instance)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
# Grace period for in-flight requests on SIGTERM
SHUTDOWN_TIMEOUT_SECONDS=10
# Time a client has to send a complete request. Raise for large uploads on slow links
REQUEST_TIMEOUT_SECONDS=60
# /api/health/ready reuses its result this long, so probes cannot load the database
HEALTH_CACHE_SECONDS=5
# Swagger UI at /api/docs. Default: on, except in production
DOCS_ENABLED=
# When both set, /api/docs requires HTTP Basic Auth
DOCS_USERNAME=
DOCS_PASSWORD=

# Auth provider: Better Auth
# Public URL of this API
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# File storage: Local disk
LOCAL_STORAGE_DIR=./uploads
UPLOAD_MAX_FILE_SIZE_MB=10
# Avoid image/svg+xml and text/html: they can run scripts
UPLOAD_ALLOWED_CONTENT_TYPES=image/png,image/jpeg,image/webp,image/gif,application/pdf

# Redis: Redis
# Docker: pnpm db:up. Railway: add a Redis service and use its REDIS_URL
REDIS_URL=redis://localhost:6379
