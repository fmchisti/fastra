{
  "name": "fastra",
  "version": "1.0.0",
  "description": "Fastra: type-safe Fastify + TypeScript API starter. Pick auth (Better Auth, Supabase, Firebase, Logto), ORM (Drizzle, Prisma), storage (S3, local), and Redis; setup deletes the rest.",
  "main": "dist/index.js",
  "scripts": {
    "deploy": "railway up",
    "dev": "tsx watch src/index.ts",
    "dev:debug": "tsx watch --inspect src/index.ts",
    "routes": "tsx scripts/routes.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:sync": "drizzle-kit generate && drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm check:fix && pnpm type-check && pnpm test",
    "setup:verify": "tsx setup/verify.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes && pnpm db:up && pnpm db:migrate",
    "db:seed": "tsx scripts/seed.ts",
    "postinstall": "prisma generate",
    "setup:project": "tsx setup/cli.ts",
    "db:migrate:deploy": "node dist/db/drizzle/migrate.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "gen:module": "tsx scripts/gen-module.ts",
    "gen:field": "tsx scripts/gen-field.ts",
    "gen:remove": "tsx scripts/gen-remove.ts",
    "gen:client": "tsx scripts/gen-client.ts",
    "env:init": "tsx scripts/init-env.ts",
    "hooks:install": "tsx scripts/install-hooks.ts",
    "build:create": "tsc -p packages/create-fastra/tsconfig.json",
    "setup:choices": "tsx setup/choices.ts"
  },
  "keywords": [
    "fastify",
    "typescript",
    "template",
    "starter",
    "api",
    "drizzle",
    "prisma",
    "better-auth"
  ],
  "author": "Fahim Mahmud Chisti",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/lib-storage": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/supabase-js": "^2.116.0",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "fastify-type-provider-zod": "^6.1.0",
    "firebase-admin": "^14.4.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prisma": "7.10.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@clack/prompts": "^1.8.1",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@smithy/util-stream": "^4.8.2",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.1",
    "aws-sdk-client-mock": "^4.1.0",
    "drizzle-kit": "^0.31.10",
    "giget": "^3.3.1",
    "ioredis-mock": "^8.13.1",
    "pino-pretty": "^13.1.3",
    "tinyglobby": "^0.2.17",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmchisti/fastra.git"
  },
  "homepage": "https://github.com/fmchisti/fastra#readme",
  "bugs": {
    "url": "https://github.com/fmchisti/fastra/issues"
  }
}
